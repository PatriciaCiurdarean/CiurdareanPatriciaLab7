<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CiurdareanPatriciaLab7.MainPage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Image
                Source="patricia.jpeg"
                HeightRequest="260"
                Aspect="AspectFit"
                SemanticProperties.Description="Profile picture" />

            <Label
                Text="Hello, my name is Patricia!"
                FontSize="26"
                HorizontalOptions="Center"
                TextColor="Black" />

            <Label
                Text="This is my first page."
                FontSize="18"
                HorizontalOptions="Center"
                TextColor="Black"
                HorizontalTextAlignment="Center"
                Margin="10,0" />

            <Button
                x:Name="CounterBtn"
                Text=""
                HeightRequest="1"
                WidthRequest="1"
                Opacity="0"
                Clicked="OnCounterClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>